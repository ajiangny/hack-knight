# Base URL of the Express API, including the /api prefix.
VITE_API_URL=

# Supabase project URL and publishable (anon) key. Both are safe in the
# browser bundle — the anon key grants only what RLS allows. Never put the
# secret key here; it belongs in backend/.env only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public, safe in the bundle). The registration
# form only renders the captcha when this is set, and the submit button stays
# disabled until the challenge passes — production must set it, paired with
# TURNSTILE_SECRET_KEY in the backend. For local dev use Cloudflare's
# always-passing test pair: site key 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
