PORT=3000
FRONTEND_URL=
SUPABASE_URL=
# Secret key — bypasses RLS, server-side only. Never ship to the browser.
SUPABASE_SECRET_KEY=
# Publishable (anon) key — used only to verify admin access tokens.
SUPABASE_ANON_KEY=
# Comma-separated allowlist of Google accounts permitted in the admin
# dashboard. A valid Google sign-in alone grants nothing; this is the check
# that makes the dashboard admin-only.
ADMIN_EMAILS=
# Cloudflare Turnstile secret for the registration form's captcha. Leave unset
# in local development to skip verification (it logs loudly when it does);
# production must set it or the captcha is decorative.
TURNSTILE_SECRET_KEY=
